PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/academic_portal

# ==========================================
# GMAIL SMTP CONFIGURATION (Real OTP Delivery)
# ==========================================
# Enter your Gmail address (e.g. your-email@gmail.com):
EMAIL_USER=your-email@gmail.com

# Google Account -> Security -> 2-Step Verification -> App Passwords
# Enter your 16-character App Password (e.g. abcd efgh ijkl mnop):
EMAIL_PASS=your-google-app-password
